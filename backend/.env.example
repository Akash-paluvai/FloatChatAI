# FloatChat Backend Configuration
PROJECT_NAME=FloatChat
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/floatchat.log

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/floatchat
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Vector DB Placeholders
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=http://localhost:8000/chroma
VECTOR_DB_COLLECTION=argo_embeddings

# AI & LLM Placeholders
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-placeholder
