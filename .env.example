# ==============================================================================
# FloatChat AI — Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Provider Keys (Optional)
#    FloatChat automatically falls back to internal scientific synthesis if unprovided.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & Infrastructure Services (Optional)
# ------------------------------------------------------------------------------
# PostgreSQL + PostGIS database connection URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/floatchat

# Redis cache server URL
REDIS_URL=redis://localhost:6379/0

# ChromaDB vector store URL & collection
VECTOR_DB_URL=http://localhost:8000/chroma
VECTOR_DB_COLLECTION=argo_embeddings

# ------------------------------------------------------------------------------
# 3. Data Pipeline File Paths
# ------------------------------------------------------------------------------
PARQUET_DATA_DIR=./SIH2025/Data/argo_prototype_parquet
METADATA_CSV_PATH=./SIH2025/Data/argo_metadata_catalog.csv

# ------------------------------------------------------------------------------
# 4. Server Configuration & Ports
# ------------------------------------------------------------------------------
PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=floatchat-super-secret-key-change-in-production-2026
